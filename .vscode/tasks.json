{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "App: Start development server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Ready in|Local:"
        }
      },
      "group": "build"
    },
    {
      "label": "Check: Lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": "$eslint-stylish",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Check: Production build",
      "type": "npm",
      "script": "build",
      "problemMatcher": "$tsc",
      "group": "build"
    }
  ]
}
